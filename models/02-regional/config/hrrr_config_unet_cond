dataset_params:
  input_data_dir: '<ERA5_HR_DATA>/0.25_era5_2010-2017'
  output_data_dir: '<SCRATCH>/hrrr/data/hrrr'
  year_range_start: 2015
  year_range_end: 2017
  normalize: True
  input_normalization_dir: '<SCRATCH>/lucie/stats_hr_2000_2009_updated.npz'
  output_normalization_dir: '<SCRATCH>/hrrr/grib2_stats_final.json'
  cache_file: '<SCRATCH>/lucie/valid_files.npz'
  cache_file_hrrr: "<SCRATCH>/hrrr/cache_hrrr_2015_2017.npz"
  force_recompute: False
  lucie_file_path: '<SCRATCH>/lucie/LUCIE_inference_start2010.npz'
  input_channels: 5
  output_channels: 4
  
  land_sea_mask: 0 # 1 for True, 0 for False
  land_sea_mask_dir: '<SCRATCH>/lucie/lsm.npz'
  name: 'celebhq'

diffusion_params:
  num_timesteps : 1000
  beta_start : 0.0001
  beta_end : 0.02

train_params:
  # General training settings
  seed: 1111  # Random seed for reproducibility
  task_name: 'unet_hrrr_cond'  # Name of the current training task
  description : 'testing unet_final_v2 without orography on, lower beta start, and linear scheduler'  # Description of the training task
  results_dir: '<HRRR_MODEL_SRC>/results'  # Directory to save results: task_dir = os.path.join(results_dir, train_config['task_name'])
  load_dir: '<HRRR_MODEL_SRC>/results'  # Directory to load results from
  load_from_checkpoint: False  # Whether to load the model from a previous checkpoint
  unet_resume_ckpt_path: '<HRRR_MODEL_SRC>/results/unet_hrrr_cond/checkpoints/latest_unet.pth'  # Path to the model checkpoint

  # Batch sizes and memory-related configurations
  ldm_batch_size: 4  # Batch size for latent diffusion model (LDM) training (limited by GPU capacity: for an HPC cluster 1 per GPU)
  unet_batch_size: 4  # Batch size for unet training (limited by GPU capacity: for an HPC cluster 4 per GPU) 
  
  # Weights for other loss components
  lambda_fft: 0.00  # Weight for FFT loss

  # Training duration
  ldm_epochs: 100  # Number of epochs for training the latent diffusion model (LDM)
  unet_epochs: 100  # Number of epochs for training the unet model

  # Learning rates for different models
  ldm_lr: 0.0001  # Learning rate for the latent diffusion model (LDM)
  unet_lr: 0.0001  # Learning rate for the unet model

  # Scheduler settings for learning rate decay
  scheduler_step_size_g: 10  # Step size for learning rate scheduler (generator)
  scheduler_gamma_g: 0.90  # Gamma for learning rate decay (generator)
  
  # Gradient accumulation settings
  unet_accumulation_steps: 1  # Number of steps to accumulate gradients for autoencoder

  # Checkpoint and saving settings
  ldm_save_interval: 10  # Interval (in epochs) to save LDM checkpoints
  checkpoint_interval: 10  # Interval (in epochs) to save model checkpoints

  # Checkpoint file names
  ldm_ckpt_name: 'ddpm_ckpt.pth'  # Checkpoint file name for LDM
  unet_ckpt_name: 'unet_ckpt.pth'  # Checkpoint file name for unet model
